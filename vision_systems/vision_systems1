        "# TODO: Do samodzielnej implemetantacji\n",
        "def dwuliniowa(I, scale_x, scale_y):\n",
        "  height, width = I.shape[:2]\n",
        "  new_height = int(height * scale_y)\n",
        "  new_width = int(width * scale_x)\n",
        "  new_image = np.zeros((new_height, new_width), dtype=I.dtype)\n",
        "  for i in range(new_height):\n",
        "    for j in range(new_width):\n",
        "      x = i / scale_y\n",
        "      y = j / scale_x\n",
        "\n",
        "      x1 = int(np.floor(x))\n",
        "      x2 = min(x1 + 1, height - 1)\n",
        "      y1 = int(np.floor(y))\n",
        "      y2 = min(y1 + 1, width - 1)\n",
        "      a = I[x1, y1]\n",
        "      b = I[x1, y2]\n",
        "      c = I[x2, y2]\n",
        "      d = I[x2, y1]\n",
        "\n",
        "      i_frac = x - x1\n",
        "      j_frac = y - y1\n",
        "\n",
        "      value = (1 - i_frac) * (1 - j_frac) * a + i_frac * (1-j_frac) * b + i_frac * j_frac * c + (1-i_frac) * j_frac * d\n",
        "\n",
        "      new_image[i, j] = int(value)\n",
        "\n",
        "  return new_image"
      ]
    },
