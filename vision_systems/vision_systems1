        "# TODO: Do samodzielnej implemetantacji\n",
        "\n",
        "def NNIN(image,scale_x,scale_y):\n",
        "\n",
        "  shape_x = image.shape[0]\n",
        "  shape_y = image.shape[1]\n",
        "  shape_x2 = int(shape_x * scale_x)\n",
        "  shape_y2 = int(shape_y * scale_y)\n",
        "  new_image = np.zeros((shape_x2,shape_y2))\n",
        "  for i in range(shape_x2):\n",
        "    for j in range(shape_y2):\n",
        "      new_x =int(i/scale_x)\n",
        "      new_y = int(j/scale_y)\n",
        "      new_x = min(new_x,shape_x -1)\n",
        "      new_y = min(new_y,shape_y -1)\n",
        "      new_image[i,j] = image[new_x,new_y]\n",
        "\n",
        "  return new_image\n",
        "\n"
      ]
