      "source": [
        "img = cv2.imread(\"knee.png\", cv2.IMREAD_GRAYSCALE)\n",
        "height, width = img.shape\n",
        "seed_x, seed_y = 230, 330\n",
        "\n",
        "\n",
        "threshold = 8\n",
        "use_adaptive = True\n",
        "\n",
        "\n",
        "visited = np.zeros_like(img, dtype=bool)\n",
        "segmented = np.zeros_like(img, dtype=bool)\n",
        "\n",
        "\n",
        "stack = [(seed_x, seed_y)]\n",
        "visited[seed_x, seed_y] = True\n",
        "segmented[seed_x, seed_y] = True\n",
        "nS = 1\n",
        "mV = float(img[seed_x, seed_y])\n",
        "\n",
        "\n",
        "while stack:\n",
        "    x, y = stack.pop()\n",
        "\n",
        "\n",
        "    if x <= 0 or x >= height - 1 or y <= 0 or y >= width - 1:\n",
        "        continue\n",
        "\n",
        "    for dx in [-1, 0, 1]:\n",
        "        for dy in [-1, 0, 1]:\n",
        "            nx, ny = x + dx, y + dy\n",
        "\n",
        "            if visited[nx, ny]:\n",
        "                continue\n",
        "\n",
        "            visited[nx, ny] = True\n",
        "            intensity = img[nx, ny]\n",
        "            if use_adaptive:\n",
        "                diff = abs(intensity - mV)\n",
        "            else:\n",
        "                diff = abs(intensity - img[x, y])\n",
        "\n",
        "            if diff < threshold:\n",
        "                segmented[nx, ny] = True\n",
        "                stack.append((nx, ny))\n",
        "                nS += 1\n",
        "                mV = mV * (nS - 1) / nS + intensity / nS\n",
        "\n",
        "\n",
        "plt.figure(figsize=(12, 6))\n",
        "plt.subplot(1, 2, 1)\n",
        "plt.title(\"Obraz oryginalny\")\n",
        "plt.imshow(img, cmap='gray')\n",
        "plt.subplot(1, 2, 2)\n",
        "plt.title(\"Segmentacja (region growing)\")\n",
        "plt.imshow(segmented, cmap='gray')\n",
        "plt.show()"
      ]
