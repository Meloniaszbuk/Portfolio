class Macierz:
    def __init__(self,matrix):
        if isinstance(matrix,tuple):
            self.__matrix = [[0 for i in range(matrix[1])] for x in range(matrix[0])]
        else:
            self.__matrix = matrix
        
    def size(self):
        return len(self.__matrix) ,len(self.__matrix[0])
    
    def __add__(self,matrix):
        if (self.size()[0] != matrix.size()[0] or self.size()[1] != matrix.size()[1]):
            raise ValueError
        
        macierz_dodawanie = Macierz((self.size()[0],self.size()[1]))
        for i in range(self.size()[0]):
            for j in range(self.size()[1]):
                macierz_dodawanie[i][j] = self.__matrix[i][j] + matrix.__matrix[i][j]
        return macierz_dodawanie        
                 
       
                
    def __mul__(self,matrix):
        
        macierz_mnozenie = Macierz((self.size()[0],matrix.size()[1]))
        for i in range(self.size()[0]):
            for j in range(matrix.size()[1]):
                for k in range(matrix.size()[0]):
                    macierz_mnozenie[i][j] +=self[i][k]*matrix[k][j]
        return Macierz(macierz_mnozenie)
    
    
    def __getitem__(self,index):
        return self.__matrix[index]
    
    def __str__(self):
        return "\n".join(["\t".join(map(str, row)) for row in self.__matrix])
            
    
def transpozycja(matrix):
    macierz_transponowana = Macierz((matrix.size()[1],matrix.size()[0]))
    for i in range(macierz_transponowana.size()[0]):
        for j in range(macierz_transponowana.size()[1]):
            macierz_transponowana[i][j] = matrix[j][i]
    return macierz_transponowana 
        
