def orientation(p, q, r):
    val = (q[1]-p[1])*(r[0]-q[0]) - (q[0]-p[0])*(r[1]-q[1])
    if val == 0:
        return 0
    elif val > 0:
        return 1
    else:
        return 2

def dist_sq(p, q):
    return (p[0]-q[0])**2 + (p[1]-q[1])**2

def convex_hull(points):
    n = len(points)
    if n < 3:
        return []
    l = 0
    for i in range(1, n):
        if points[i][0] < points[l][0] or (points[i][0] == points[l][0] and points[i][1] < points[l][1]):
            l = i
    hull = []
    p = l
    while True:
        hull.append(points[p])
        q = (p+1)%n
        for r in range(n):
            if orientation(points[p], points[q], points[r]) == 2:
                q = r
        p = q
        if p == l:
            break
    return hull

def convex_hull_colinear(points):
    n = len(points)
    if n < 3:
        return []
    l = 0
    for i in range(1, n):
        if points[i][0] < points[l][0] or (points[i][0] == points[l][0] and points[i][1] < points[l][1]):
            l = i
    hull = []
    p = l
    while True:
        hull.append(points[p])
        q = (p+1)%n
        for r in range(n):
            o = orientation(points[p], points[q], points[r])
            if o == 2:
                q = r
            elif o == 0:
                if dist_sq(points[p], points[r]) > dist_sq(points[p], points[q]):
                    q = r
        p = q
        if p == l:
            break
    return hull

sets = [
    [(0, 3), (0, 0), (0, 1), (3, 0), (3, 3)],
    [(0, 3), (0, 1), (0, 0), (3, 0), (3, 3)],
    [(2, 2), (4, 3), (5, 4), (0, 3), (0, 2), (0, 0), (2, 1), (2, 0), (4, 0)]
]

for idx, points in enumerate(sets):
    print(f"\nZestaw {idx+1}: {points}")
    hull1 = convex_hull(points)
    print(hull1)
    hull2 = convex_hull_colinear(points)
    print(hull2)
